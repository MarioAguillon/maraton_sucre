# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui

# Server
PORT=3000
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:4200


# Email (Gmail: usar una "contraseña de aplicación", requiere verificación en 2 pasos)
EMAIL_USER=triatlonsucresantander@gmail.com
EMAIL_PASS=tu-contrasena-de-aplicacion

# Supabase service_role (SOLO backend; necesaria para editar/eliminar desde el panel admin)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Panel de administración
ADMIN_USER=tu-usuario-admin
ADMIN_PASS=tu-contrasena-admin
# Secreto para firmar tokens de sesión (genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_TOKEN_SECRET=cambia-esto-por-un-secreto-largo
